# 复制本文件为 .env 后填入真实值；.env 已被 .gitignore，不会进 GitHub。
# cp .env.example .env

# --- Kavita OPDS（书目前门） ---
KAVITA_OPDS_URL=http://your-kavita-host/api/opds/<opds-id>
KAVITA_OPDS_KEY=<your-opds-key>

# --- SiYuan 同步目标：笔记本 books笔记 / 文件夹 ai辅助 ---
SIYUAN_NOTEBOOK_ID=20250110135033-q7lwd41
SIYUAN_TARGET_PATH=/ai辅助

# --- 可选：纯脚本直连 SiYuan 内核 API 时才需要（默认走 MCP，可留空） ---
SIYUAN_API_URL=
SIYUAN_TOKEN=
